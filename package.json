{
  "name": "my-supervisor",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "ci": "pnpm run ci:fmt && pnpm run ci:clippy",
    "ci:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "ci:fmt": "cargo fmt --all -- --check",
    "ci:local": "prek run --all-files",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.6",
    "release-it": "^20.2.1"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": {"script": "pnpm build:e2e", "cwd": "ui"},
    "frontendDist": "ui/dist-e2e",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "my-supervisor", "width": 1100, "height": 720, "resizable": true, "incognito": true, "visible": false, "focus": false, "focusable": false, "skipTaskbar": true}],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-eval'; style-src 'self'; img-src 'self' asset: data:; font-src 'self' data:; connect-src 'self'",
      "capabilities": [
        {"identifier": "desktop-e2e", "windows": ["main"], "permissions": ["core:default", "wdio:default", "core:window:allow-set-size"]}
      ]
    }
  }
}

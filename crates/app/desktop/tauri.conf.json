{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-supervisor",
  "version": "0.1.0",
  "identifier": "com.my-supervisor.desktop",
  "build": {
    "frontendDist": "../../../packages/ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
